{
  "name": "beforeitdries",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "dev": "devvit playtest",
    "login": "NODE_USE_ENV_PROXY=1 devvit login --copy-paste",
    "deploy": "vite build && NODE_USE_ENV_PROXY=1 devvit upload",
    "launch": "npm run deploy && devvit publish",
    "test": "vitest run",
    "type-check": "tsc -p src/client && tsc -p src/server && tsc -p .",
    "compare": "node tools/compare-render.mjs",
    "preview": "vite build && esbuild tools/preview-server.ts --bundle --platform=node --format=esm --outfile=dist/preview-server.mjs --log-level=warning && node dist/preview-server.mjs",
    "playtest:upload": "bash tools/playtest-upload.sh"
  },
  "dependencies": {
    "@devvit/web": "0.15.1",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "express": "5.1.0",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@devvit/start": "0.15.1",
    "@types/express": "5.0.3",
    "@types/node": "22.15.21",
    "devvit": "0.15.1",
    "esbuild": "0.25.9",
    "typescript": "5.8.3",
    "vite": "7.3.5",
    "vitest": "4.1.0"
  }
}
