{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "beforeitdries",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "play.html",
        "height": "tall"
      },
      "duel": {
        "entry": "duel.html"
      },
      "play": {
        "entry": "play.html",
        "height": "tall"
      },
      "name": {
        "entry": "name.html",
        "height": "tall"
      },
      "sheet": {
        "entry": "sheet.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": [
        "SUBMIT_POST",
        "SUBMIT_COMMENT"
      ]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Before It Dries: post a new play post",
        "description": "Creates and pins a new post for the paint duel and the dice",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-play"
      },
      {
        "label": "Before It Dries: post today's sheet now",
        "description": "Creates a new post for today's Bleach sheet (the scheduler does this shortly after midnight UTC)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-sheet"
      },
      {
        "label": "Before It Dries: set up the community",
        "description": "Adds or updates the rules, removal reasons, post flairs, sidebar and the how-to-play wiki page",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/setup-community"
      },
      {
        "label": "Before It Dries: name it now",
        "description": "Takes the top valid name from the comments right away",
        "location": "post",
        "forUserType": "moderator",
        "postFilter": "currentApp",
        "endpoint": "/internal/menu/name-now"
      },
      {
        "label": "Before It Dries: cancel naming",
        "description": "Closes this naming post without a name",
        "location": "post",
        "forUserType": "moderator",
        "postFilter": "currentApp",
        "endpoint": "/internal/menu/cancel-naming"
      },
      {
        "label": "Before It Dries: withdraw this name",
        "description": "Use on the comment with a species name (or Sepia's Bestiary comment): removes the name comment and opens the species again",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/withdraw-name"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade",
    "onPostDelete": "/internal/triggers/on-post-delete",
    "onCommentDelete": "/internal/triggers/on-comment-delete"
  },
  "scheduler": {
    "tasks": {
      "name-species": {
        "endpoint": "/internal/scheduler/name-species"
      },
      "daily-sheet": {
        "endpoint": "/internal/scheduler/daily-sheet",
        "cron": "2 0 * * *"
      },
      "account-check": {
        "endpoint": "/internal/scheduler/account-check",
        "cron": "37 3 * * *"
      },
      "account-purge": {
        "endpoint": "/internal/scheduler/account-purge"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "dev": {
    "subreddit": "beforeitdries_dev"
  }
}
