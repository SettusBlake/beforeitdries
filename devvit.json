{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "beforeitdries",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "play.html",
        "height": "tall"
      },
      "duel": {
        "entry": "duel.html"
      },
      "play": {
        "entry": "play.html",
        "height": "tall"
      },
      "name": {
        "entry": "name.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true
    }
  },
  "menu": {
    "items": [
      {
        "label": "Before It Dries: post a new play post",
        "description": "Creates and pins a new post for the paint duel and the dice",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-play"
      },
      {
        "label": "Before It Dries: name it now",
        "description": "Takes the top valid name from the comments right away",
        "location": "post",
        "forUserType": "moderator",
        "postFilter": "currentApp",
        "endpoint": "/internal/menu/name-now"
      },
      {
        "label": "Before It Dries: cancel naming",
        "description": "Closes this naming post without a name",
        "location": "post",
        "forUserType": "moderator",
        "postFilter": "currentApp",
        "endpoint": "/internal/menu/cancel-naming"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "scheduler": {
    "tasks": {
      "name-species": {
        "endpoint": "/internal/scheduler/name-species"
      }
    }
  },
  "settings": {
    "subreddit": {
      "dryHours": {
        "type": "number",
        "label": "Drying time between glazes (hours)",
        "helpText": "0 to 72. Default 8. Set to 0 for playtests.",
        "defaultValue": 8
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "beforeitdries"
  }
}
